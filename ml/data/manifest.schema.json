{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aranya.ai/schemas/ml-manifest-v0.json",
  "title": "Aranya acoustic recording manifest v0",
  "description": "One row per original recording; split by recording group before window generation.",
  "type": "object",
  "required": ["file_id", "path", "label", "background_subtype", "source_name", "source_url", "license", "license_verified", "attribution_required", "recording_group_id", "session_id", "source_identity", "location_description", "environment_description", "microphone", "sample_rate_hz", "channels", "duration_seconds", "event_start_seconds", "event_end_seconds", "annotation_confidence", "annotator", "split", "notes"],
  "properties": {
    "file_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "label": {"enum": ["gunshot", "chainsaw_logging", "metal_tool_activity", "background", "fire", "mixed_event", "unknown_mixed"]},
    "background_subtype": {"enum": ["", "forest_ambience", "birds_animals", "wind", "rain", "vehicles", "machinery", "human_movement", "generic_impacts", "other_environmental_noise"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "license_verified": {"type": "boolean"},
    "attribution_required": {"type": "boolean"},
    "recording_group_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "source_identity": {"type": "string", "minLength": 1},
    "location_description": {"type": "string"},
    "environment_description": {"type": "string"},
    "microphone": {"type": "string", "minLength": 1},
    "sample_rate_hz": {"type": "integer", "exclusiveMinimum": 0},
    "channels": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "format": {"type": "string", "minLength": 1},
    "size_bytes": {"type": "integer", "exclusiveMinimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_start_seconds": {"type": ["number", "null"], "minimum": 0},
    "event_end_seconds": {"type": ["number", "null"], "minimum": 0},
    "annotation_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "annotator": {"type": "string", "minLength": 1},
    "split": {"enum": ["", "train", "validation", "test"]},
    "training_eligible": {"type": "boolean"},
    "previous_test_use": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
